---
// A group of projects on the Research page: a key image, then each project's
// title, year, short summary, and any linked articles, reports, or news.
// Clicking a title (or "Read more") opens the full write-up in the pop-up.
// With `plain`, the key image and group heading are left out (used under Earlier Work).
import NewsList from './NewsList.astro';
import ToolList from './ToolList.astro';
import { articleSections, newsFor, toolsFor } from '../lib/data';
const { group, projects, plain = false } = Astro.props;
const items = group.projects.map((id: string) => projects.find((p: any) => p.id === id)).filter(Boolean);
const linksFor = (p: any) => [
  ...articleSections(p.data.articles, p.data.image),
  ...(newsFor(p.id).length > 0 ? [{ heading: 'In the news', items: newsFor(p.id) }] : []),
];
---
<article class:list={['species', { 'species--plain': plain }]} id={plain ? undefined : group.id}>
  {!plain && (
    <div class:list={['species__sketch', { 'species__sketch--photo': group.photo, 'species__sketch--figure': group.figure }]}>
      <img src={group.sketch} alt={group.sketch_alt} title={group.sketch_alt} loading="lazy" />
    </div>
  )}
  <div class="species__body">
    {!plain && group.title && <h3>{group.title} {group.since && <span class="species__years">{group.since}–present</span>}</h3>}
    <ul class="species__projects">
      {items.map((p: any) => (
        <li class="proj">
          <a class="proj__head" href={`/research/${p.id}/`} data-project={p.id}>
            <span class="species__ptitle">{p.data.title}</span>
            <span class="species__pyear">{p.data.year}</span>
          </a>
          {p.data.summary && (
            <p class="proj__summary">
              {p.data.summary}{' '}
              <a class="proj__more" href={`/research/${p.id}/`} data-project={p.id} aria-label={`Read more about ${p.data.title}`}>Read more</a>
            </p>
          )}
          {linksFor(p).map((sec) => (
            <div class="proj__links">
              <h4>{sec.heading}</h4>
              <NewsList items={sec.items} />
            </div>
          ))}
          {toolsFor(p.id).length > 0 && (
            <div class="proj__links">
              <h4>Interactive tools</h4>
              <ToolList items={toolsFor(p.id)} />
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</article>
